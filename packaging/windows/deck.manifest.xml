<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  deck.exe's manifest. Same settings as vendor/gpui/resources/windows/gpui.manifest.xml
  (per-monitor DPI, Common Controls 6) plus consoleAllocationPolicy: deck.exe is a
  console-subsystem program (it is also the `deck` CLI), and "detached" tells
  Windows 11 24H2 and later not to open a console window for it when it starts
  from Explorer or the Start menu. Older Windows ignores the element; win_console.rs
  closes the console there instead.
  crates/app/build.rs embeds this only when gpui's own build script did not
  embed gpui.manifest.xml (cross builds from Linux), so there is never a second one.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:application>
        <asmv3:windowsSettings>
            <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
            <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
            <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
        </asmv3:windowsSettings>
    </asmv3:application>
    <dependency>
        <dependentAssembly>
            <assemblyIdentity type="win32"
                name="Microsoft.Windows.Common-Controls"
                version="6.0.0.0" processorArchitecture="*"
                publicKeyToken="6595b64144ccf1df" />
        </dependentAssembly>
    </dependency>
</assembly>
